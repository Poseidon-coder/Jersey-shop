import React, { useState } from 'react';
import { FaStar, FaCartPlus, FaHeart, FaRegHeart, FaBolt } from 'react-icons/fa';

function ProductCard({ product }) {
  if (!product) return null;

  // Filter out empty image URLs and set initial image state
  const validImages = product.imgs?.filter((img) => img && img.trim() !== '') || [];
  const [selectedImg, setSelectedImg] = useState(
    validImages[0] || 'https://via.placeholder.com/400x400?text=No+Image'
  );
  const [isWishlisted, setIsWishlisted] = useState(false);

  // Safely extract sizes array from specification or root
  const sizes = product.specification?.sizesAvailable || product.sizesAvailable || [];
  const formattedSizes = Array.isArray(sizes) ? sizes.join(', ') : sizes;

  return (
    <div className="relative flex max-w-xs flex-col justify-between overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-md transition-shadow duration-300 hover:shadow-xl">
      
      {/* Top Badges & Wishlist Overlay */}
      <div className="absolute top-3 left-3 right-3 z-10 flex items-center justify-between pointer-events-none">
        <div className="flex flex-col gap-1">
          {product.flashsale && (
            <span className="flex items-center gap-1 rounded-full bg-amber-500 px-2.5 py-1 text-[10px] font-bold text-white shadow">
              <FaBolt className="text-xs" /> FLASH SALE
            </span>
          )}
          {product.bestseller && (
            <span className="rounded-full bg-emerald-600 px-2.5 py-1 text-[10px] font-bold text-white shadow">
              BESTSELLER
            </span>
          )}
        </div>

        <button
          type="button"
          onClick={() => setIsWishlisted(!isWishlisted)}
          className="pointer-events-auto rounded-full bg-white/80 p-2 text-gray-600 shadow backdrop-blur-sm transition-colors hover:bg-white hover:text-red-500"
          aria-label="Wishlist"
        >
          {isWishlisted ? (
            <FaHeart className="text-red-500" />
          ) : (
            <FaRegHeart />
          )}
        </button>
      </div>

      {/* Main Image Container */}
      <div className="relative aspect-square w-full bg-gray-50 flex items-center justify-center overflow-hidden border-b border-gray-100 group">
        <img
          src={selectedImg}
          alt={product.name}
          className="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />

        {/* Out of Stock Overlay */}
        {product.instock === false && (
          <div className="absolute inset-0 flex items-center justify-center bg-black/60 text-xs font-bold uppercase tracking-wider text-white backdrop-blur-[2px]">
            Out of Stock
          </div>
        )}
      </div>

      {/* Optional Gallery Thumbnails */}
      {validImages.length > 1 && (
        <div className="flex gap-1.5 px-4 pt-3 overflow-x-auto">
          {validImages.map((img, index) => (
            <button
              key={index}
              onClick={() => setSelectedImg(img)}
              className={`h-9 w-9 flex-shrink-0 overflow-hidden rounded-md border-2 transition-all ${
                selectedImg === img
                  ? 'border-slate-900 ring-1 ring-slate-900'
                  : 'border-transparent opacity-60 hover:opacity-100'
              }`}
            >
              <img src={img} alt={`Thumbnail ${index + 1}`} className="h-full w-full object-cover" />
            </button>
          ))}
        </div>
      )}

      {/* Card Content */}
      <div className="p-4 space-y-2">
        {/* ID & Category */}
        <div className="flex justify-between items-center text-xs text-black font-mono font-bold">
          <span>ID.{product.id}</span>
          <span className="uppercase font-sans font-medium text-gray-500 tracking-wide">
            {product.category}
          </span>
        </div>

        {/* Product Title */}
        <h3 className="text-base font-bold text-gray-900 leading-snug line-clamp-1" title={product.name}>
          {product.name}
        </h3>

        {/* Brand & Season */}
        <div className="flex items-center justify-between text-xs text-gray-600">
          <span className="font-medium">{product.brand}</span>
          <span className="text-gray-400">{product.season}</span>
        </div>

        {/* Rating Stars */}
        <div className="flex text-amber-400 gap-1 text-xs py-0.5">
          <FaStar />
          <FaStar />
          <FaStar />
          <FaStar />
          <FaStar />
        </div>

        {/* Available Sizes */}
        {formattedSizes && (
          <p className="text-xs text-gray-500 font-medium">
            Available: <span className="text-gray-700 font-semibold">{formattedSizes}</span>
          </p>
        )}

        {/* Pricing & Add to Cart Action */}
        <div className="flex justify-between items-center pt-3 border-t border-gray-100 mt-2">
          <div className="flex items-baseline gap-2">
            <span className="font-bold text-gray-900 text-lg">{product.price}</span>
            {product.originalprice && (
              <del className="font-mono text-xs text-gray-400 font-normal">
                {product.originalprice}
              </del>
            )}
          </div>

          <button
            disabled={product.instock === false}
            className="flex items-center gap-2 text-white bg-slate-900 hover:bg-slate-800 disabled:bg-gray-300 disabled:cursor-not-allowed px-4 py-2 rounded-xl text-xs font-semibold transition-colors active:scale-95"
          >
            Add <FaCartPlus className="text-sm" />
          </button>
        </div>
      </div>
    </div>
  );
}

export default ProductCard;